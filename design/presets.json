      "expect": {
        "tone": "dead", "headline": "DEFAULT DEAD", "line1": "Out of cash in 7.5 months · Aug 2026", "line2": "Needs $665k · $265k short",
        "hints": { "cash": "≥ $665k", "expenses": "≤ $64.1k", "revenue": "≥ $28.8k", "growth": "≥ 13.7%" }
      }
    },
    {
      "name": "never",
      "input": { "cash": "$600k", "expenses": "80k", "revenue": "20k", "growth": "0%" },
      "expect": {
        "tone": "dead", "headline": "DEFAULT DEAD", "line1": "Out of cash in 10.0 months · Nov 2026", "line2": "Never profitable at this growth",
        "hints": { "cash": "never", "expenses": "≤ $20k", "revenue": "≥ $80k", "growth": "≥ 8.86%" }
      }
    },
    {
      "name": "broke",
