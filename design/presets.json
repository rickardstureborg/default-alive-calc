{
  "about": "Gallery states for design/index.html and `make snapshot`, and the shared spec: Swift (PresetTests) and JS (model.test.mjs) must both produce `expect` from `input` (+ optional `units`, default month, and `linear`, default false) at `now`. Change `expect` when the design changes on purpose.",
  "now": "2026-01-10",
  "presets": [
    {
      "name": "alive",
      "input": { "cash": "$1.2M", "expenses": "80k", "revenue": "20k", "growth": "8%" },
      "expect": {
        "tone": "alive", "headline": "DEFAULT ALIVE", "line1": "Profitable in 18.0 months · Jul 2027", "line2": "Needs $661k · $539k to spare",
        "hints": { "cash": "≥ $661.5k", "expenses": "≤ $106.9k", "revenue": "≥ $10.6k", "growth": "≥ 4.34%" }
      }
    },
    {
      "name": "commas",
      "input": { "cash": "1630000", "expenses": "80000", "revenue": "20000", "growth": "8" },
      "expect": {
        "tone": "alive", "headline": "DEFAULT ALIVE", "line1": "Profitable in 18.0 months · Jul 2027", "line2": "Needs $661k · $969k to spare",
        "hints": { "cash": "≥ $661.5k", "expenses": "≤ $125.7k", "revenue": "≥ $6.67k", "growth": "≥ 3.18%" }
      }
    },
    {
