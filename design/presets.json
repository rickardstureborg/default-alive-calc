        "tone": "dead", "headline": "DEFAULT DEAD", "line1": "Out of cash in 7.6 months · Aug 2026", "line2": "Needs $661k · $261k short",
        "hints": { "cash": "≥ $661.5k", "expenses": "≤ $64.2k", "revenue": "≥ $28.7k", "growth": "≥ 13.6%" }
      }
    },
    {
